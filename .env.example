# Telegram bot token dari BotFather
# Wajib. Tanpa ini bot menolak start.
TELEGRAM_TOKEN=

# ---------------------------------------------------------------
# ADMIN
# ---------------------------------------------------------------
# Daftar ID Telegram yang punya akses admin. Pisahkan dengan koma.
# Format diterima: 123,456  |  [123, 456]  |  123 456
# Cara lihat ID: kirim /id ke bot ini, atau chat @userinfobot.
# Kosongkan kalau belum butuh admin (bot tetap jalan normal).
ADMIN_IDS=

# ---------------------------------------------------------------
# AI ASSISTANT (gateway OpenAI-compatible)
# ---------------------------------------------------------------
# Kosongkan AI_API_KEY kalau fitur AI belum dipakai.
# Bot tetap start; menu AI hanya menampilkan "belum dikonfigurasi".
# API key dibuat di https://ai.hisoka.net/dashboard/api-keys
AI_BASE_URL=https://ai.hisoka.net/api/v1
AI_API_KEY=
AI_MODEL=deepseek-v4.1-flash-1017

# Kreativitas jawaban (0.0 - 2.0). 0.7 = seimbang.
AI_TEMPERATURE=0.7

# Batas panjang jawaban untuk pengguna biasa.
AI_MAX_TOKENS=1400

# Batas panjang jawaban untuk user yang ada di ADMIN_IDS.
# Pakai nilai lebih besar kalau admin butuh jawaban detail.
AI_MAX_TOKENS_ADMIN=2400
