# Telegram bot token dari BotFather
TELEGRAM_TOKEN=

# Daftar ID Telegram yang jadi admin bot (pisahkan dengan koma).
# Cara lihat ID: kirim pesan ke @userinfobot, atau pakai /id di bot ini.
# Contoh: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# AI assistant (OpenAI-compatible gateway)
# Dapatkan API key di https://ai.hisoka.net/dashboard/api-keys
AI_BASE_URL=https://ai.hisoka.net/api/v1
AI_API_KEY=
AI_MODEL=deepseek-v4.1-flash-1017
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1400
AI_MAX_TOKENS_ADMIN=2400
